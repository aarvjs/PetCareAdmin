rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Helper: Enforce image MIME type and 10MB size limit
    function isValidImage() {
      return request.resource.contentType.matches('image/.*')
        && request.resource.size <= 10 * 1024 * 1024;
    }

    // Business logos, product images, doctor photos & clinic media
    match /businesses/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && isValidImage();
      allow delete: if request.auth != null;
    }

    // User profile avatars
    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && isValidImage();
      allow delete: if request.auth != null;
    }

    // Fallback: Authenticated users can write valid images, public read
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && isValidImage();
      allow delete: if request.auth != null;
    }
  }
}
