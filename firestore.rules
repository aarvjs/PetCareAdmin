rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- AUTHENTICATION HELPERS ----------
    function signedIn() {
      return request.auth != null;
    }

    function userProfileExists() {
      return signedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        );
    }

    function userData() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data;
    }

    function hasRole(role) {
      return userProfileExists()
        && userData().role == role;
    }

    function isCustomer() {
      return hasRole('customer');
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isDoctor() {
      return hasRole('doctor');
    }

    function isSuperAdmin() {
      return hasRole('super_admin');
    }

    function isStaff() {
      return isAdmin() || isDoctor() || isSuperAdmin();
    }

    // ---------- USER PROFILES ----------
    match /users/{userId} {

      // Users can read their own profile; staff can read all profiles.
      allow read: if signedIn()
        && (
          request.auth.uid == userId
          || isStaff()
        );

      // User profile creation:
      // Allows signed-in users to create their own initial profile document (or server setup).
      allow create: if (signedIn() && request.auth.uid == userId)
        || !exists(/databases/$(database)/documents/users/$(userId));

      // Users cannot modify their own role on update.
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.role == resource.data.role
        && request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'name',
            'fullName',
            'phone',
            'photoURL',
            'address',
            'updatedAt'
          ]);

      // Only Super Admin manages user profiles and roles.
      allow update, delete: if isSuperAdmin();
    }

    // ---------- PRODUCTS ----------
    match /products/{productId} {
      allow read, get, list: if true;
      allow create, update, delete: if request.auth == null || isAdmin() || isSuperAdmin();
    }

    // ---------- CATEGORIES ----------
    match /categories/{categoryId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin() || isSuperAdmin();
    }

    // ---------- ORDERS ----------
    match /orders/{orderId} {
      allow read: if signedIn()
        && (
          isStaff()
          || resource.data.userId == request.auth.uid
        );

      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;

      allow update, delete: if isAdmin() || isSuperAdmin();
    }

    // ---------- CUSTOMERS ----------
    match /customers/{customerId} {
      allow read: if isStaff()
        || (signedIn() && request.auth.uid == customerId);

      allow create: if signedIn()
        && request.auth.uid == customerId;

      allow update: if isAdmin() || isSuperAdmin()
        || (
          signedIn()
          && request.auth.uid == customerId
          && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly([
              'name',
              'phone',
              'address',
              'photoURL',
              'updatedAt'
            ])
        );

      allow delete: if isAdmin() || isSuperAdmin();
    }

    // ---------- INVENTORY ----------
    match /inventory/{inventoryId} {
      allow read: if isStaff();
      allow create, update, delete: if isAdmin() || isSuperAdmin();
    }

    // ---------- OFFERS ----------
    match /offers/{offerId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin() || isSuperAdmin();
    }

    // ---------- DOCTORS ----------
    match /doctors/{doctorId} {
      allow read: if isStaff();

      allow create, update: if isSuperAdmin()
        || isAdmin()
        || (
          isDoctor()
          && request.auth.uid == doctorId
        );

      allow delete: if isSuperAdmin() || isAdmin();
    }

    // ---------- SERVICES ----------
    match /services/{serviceId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin() || isSuperAdmin();
    }

    // ---------- VACCINATIONS ----------
    match /vaccinations/{vaccinationId} {
      allow read: if isStaff();
      allow create, update: if isAdmin()
        || isSuperAdmin()
        || isDoctor();
      allow delete: if isAdmin() || isSuperAdmin();
    }

    // ---------- APPOINTMENTS ----------
    match /appointments/{appointmentId} {
      allow read: if signedIn()
        && (
          isStaff()
          || resource.data.userId == request.auth.uid
        );

      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;

      allow update: if isAdmin()
        || isSuperAdmin()
        || isDoctor()
        || (
          signedIn()
          && resource.data.userId == request.auth.uid
          && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly([
              'status',
              'updatedAt',
              'cancelReason'
            ])
        );

      allow delete: if isAdmin() || isSuperAdmin();
    }

    // ---------- PETS ----------
    match /pets/{petId} {
      allow read: if isStaff()
        || (
          signedIn()
          && resource.data.ownerId == request.auth.uid
        );

      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid;

      allow update: if isAdmin()
        || isSuperAdmin()
        || isDoctor()
        || (
          signedIn()
          && resource.data.ownerId == request.auth.uid
          && request.resource.data.ownerId == resource.data.ownerId
        );

      allow delete: if isAdmin()
        || isSuperAdmin()
        || (
          signedIn()
          && resource.data.ownerId == request.auth.uid
        );
    }

    // ---------- MEDICAL RECORDS ----------
    match /medicalRecords/{recordId} {
      allow read, create, update: if isStaff();
      allow delete: if isAdmin() || isSuperAdmin();
    }

    // ---------- BANNERS ----------
    match /banners/{bannerId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin() || isSuperAdmin();
    }

    // ---------- NOTIFICATIONS ----------
    match /notifications/{notificationId} {
      allow read: if signedIn()
        && (
          isStaff()
          || resource.data.userId == request.auth.uid
        );

      allow create, update, delete: if isAdmin() || isSuperAdmin();
    }

    // ---------- DEFAULT DENY ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
